{
  // Cloudflare Workers settings for the website.
  // The site is plain files ("static assets"); worker/index.js handles /api/* and the order desk
  // and passes everything else through to the files.
  // Secrets (DESK_PASSWORD, DESK_PATH, RESEND_API_KEY) are set in the Cloudflare dashboard: see DESK-SETUP.txt.
  "name": "limitless-innovations-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "limitless-site", "database_id": "effbb949-93b8-4aec-a370-620796ec302c" }
  ],
  // Desk 2.0: private storage for the desk's header photos (a separate bucket from the audit app's). Served only through
  // the Worker, after the desk login. See DESK-SETUP.txt.
  "r2_buckets": [
    { "binding": "DESK_FILES", "bucket_name": "limitless-site-files" }
  ],
  // keep_vars: settings you add in the Cloudflare dashboard (BANK_DETAILS, ALERT_FROM...) survive each deploy
  "keep_vars": true,
  "vars": {
    "ALERT_TO": "info@limitlessinnovations.co.uk",
    "SITE_URL": "https://limitlessinnovations.co.uk",
    // "on" = the whole website asks for the desk password (private preview). "off" = public.
    "SITE_LOCKED": "on"
  },
  // Hourly clean-up (tidy in worker/index.js): old IP addresses, old messages and enquiries, rate-limit rows,
  // as promised in the privacy notice.
  "triggers": { "crons": ["23 * * * *"] },
  "observability": { "enabled": true }
}
