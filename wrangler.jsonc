{
  // Cloudflare Workers settings for the website. The site is plain files ("static assets"):
  // there is no build step and no server code. See .assetsignore for what is NOT published.
  "name": "limitless-innovations-website",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true }
}
